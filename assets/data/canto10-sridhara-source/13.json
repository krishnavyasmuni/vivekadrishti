{
  "chapter": 13,
  "source_path": "12-17/13.md",
  "entries": {
    "1": {
      "start": 1,
      "end": 1,
      "sanskrit": "त्रयोदशेऽहरद् ब्रह्मा वत्सान् पालांश् च मायया ।\n\nतदा तत्-सर्व-रूपोऽब्दं कृष्णः पूर्ववद् आचरत् ॥\n\nनूतनयसि नव्यवत् करोसि ॥१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "2": {
      "start": 2,
      "end": 2,
      "sanskrit": "तथा हि, सार-भृतां सार-ग्रहिणाम्, अयं निसर्गः स्वभावः । कोऽसौ ? अच्युतस्य वार्ता श्रुता सती प्रतिक्षणं साधु नव्यवद् भवतीति यत् सः । विटानां स्त्रैणानां, स्त्रियाः कामिन्या वार्ता इव । कथम्-भूतानाम् अपि सताम् ? या अच्युत-वार्ता सैवार्थो येषां तानि, वाणी-श्रुति-चेतांसि तथा-भूतानाम् अपि ॥२॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "3": {
      "start": 3,
      "end": 3,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "4": {
      "start": 4,
      "end": 4,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "5": {
      "start": 5,
      "end": 5,
      "sanskrit": "भोजन-विधानाय पुलिनं स्तौति---अहो इति । स्वीयानां केलीनां संपदो विद्यन्ते यस्मिंस् तत् । मृदुला-अच्छा-वालुका यस्मिंस् तत् । किं च, स्फुटद् विकसत् सरः । सरोज-बाहुल्येनोपचारतः सर एव विकसद् इत्य् उक्तम् । तस्य गन्धस् तेन हृता आकृष्टा अलयः पत्रिणश् च ये तेषां, के उदके ध्वनयस् तेषां, प्रतिध्वानास् तैर् लसन्तो द्रुमास् तैर् आकुलं व्याप्तम् ॥५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "6": {
      "start": 6,
      "end": 6,
      "sanskrit": "दिवा रूढं वेलातीतेत्य् अर्थः ॥६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "7": {
      "start": 7,
      "end": 7,
      "sanskrit": "आरुध्य संरुध्य, शाद्वले हरित-तृणे देशे ॥७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "8": {
      "start": 8,
      "end": 8,
      "sanskrit": "तदा ते विरेजुः । कृष्णस्य विष्वक् परितः । पुरु-राजि-मण्डलैर् बहुभिः पङ्क्ति-मण्डलैः सह नैरन्तर्येणोपविष्टाः । श्री-कृष्णाभिमुखानि-आननानि येषां ते । फुल्ल-दृशो विकसित-नयनाः । कमल-कर्णिकायाः परितः पत्राणि यथेति ॥८॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "9": {
      "start": 9,
      "end": 9,
      "sanskrit": "पुष्पैस् तद्-दलैः, अन्यैश् च पत्रैः कृतानि भाजनान्इ यैस् ते ॥९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "10": {
      "start": 10,
      "end": 10,
      "sanskrit": "रुचिं स्वाद-विशेषम् । अभ्यवजह्रुर् बुभुजिरे । सह-ईश्वराः श्री-कृष्ण-सहिताः॥१०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "11": {
      "start": 11,
      "end": 11,
      "sanskrit": "यज्ञ-भुग् अपि तेषु बुभुजे । बालानाम् इव केलिर् यस्य सः । तद् आह---उदर-वस्त्रयोर् मध्ये वेणुं बिभ्रद् दधद् इति, सर्वत्र सम्बध्यते वाम इति, कक्ष-पाण्योर् विशेषणम् । मसृणं स्निग्धं दध्योदन-कवलम् । तद्-उचितानि बिल्वाम् अलकादि-फलान्य् अङ्गुलि-सन्धिषु । कर्णिकेव सर्वाभिमुखो मध्ये तिष्ठन्, स्वस्य परित उपविष्टान् सुहृदः स्वैर् नर्मभिः परिहास-वाक्यैः । स्वर्गे स्वर्ग-निवासिनि जने-मिषत्य् आश्चर्येण पश्यति सति लोके जन-मध्ये बुभुजे ॥११॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "12": {
      "start": 12,
      "end": 12,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "13": {
      "start": 13,
      "end": 13,
      "sanskrit": "भी-भयं भय-हेतुभ्यो भयम् अस्यापास्य । यद् वा, अस्य विश्वस्य भियोऽपि भयं यः श्री-कृष्णः । आशाद् भोजनात् । अस्मिन् पादे अक्षराधिक्यम् आर्षम् ॥१३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "14": {
      "start": 14,
      "end": 14,
      "sanskrit": "अद्रिषु तेषां दरीषु । कुञ्जेषु लतादि-पिहितोदर-विवरेषु । गह्वरेषु च ॥१४॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "15": {
      "start": 15,
      "end": 15,
      "sanskrit": "अम्भो जन्मनः पद्माज् जनिर् यस्य स, ब्रह्मा तद्-अनन्तरे तस्मिन्न् अवसरे गत आगतस् तच्-छिद्रं प्राप्तो वा । मञ्जु मनोहरम् अन्यद् अपि महित्वं महिमानं द्रष्टुं तस्य वत्सान् इतः स्थानात् पुलिनाद् वत्सपांश् चान्यत्र नीत्वा स्वयं तिरोबभूव । प्रभवतः श्री-कृष्णस्य ॥१५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "16": {
      "start": 16,
      "end": 16,
      "sanskrit": "उभौ अपि वत्सान् वतस्पंश् चेत्य् अर्थः । विचिकाय अन्वीक्षितवान् ॥१६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "17": {
      "start": 17,
      "end": 17,
      "sanskrit": "विधि-कृतं ब्रह्मणा कृतम् ॥१७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "18": {
      "start": 18,
      "end": 18,
      "sanskrit": "उभयायितं वत्स-तत्-पाल-रूपेण वर्तमानम् इत्य् अर्थः । अयं भावः । यदि तूष्णीम् आसे, तर्हि तन्-मातॄणां विषादः स्याद्, यदि च तान् एवानयिष्यामि तर्हि ब्रह्मणो मोहो न स्याद् इति । तद् उभय-प्रीतये तथा चक्रे इति ।\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "19": {
      "start": 19,
      "end": 19,
      "sanskrit": "तद् एव दर्शयति---यावद् इति । वत्सपानां वत्सकानां च अल्पकं वपुः यत्-प्रमानकं प्रमाणम् अनतिक्रम्येत्य् अर्थः । एवम् उपर्य् अपि योज्यम् । तत्र दलं पर्ण-रूपो वाद्य-विशेषः । यद् वा, अत्र वेणु-दलं वेणु-खण्डम् । शिक् शिक्यम् । यद् वा, यावद् वत्सपादि-वपुः, तावत् सर्व-स्वरूप-अजः कृष्णो बभौ इत्य् अर्थः । उत्तरत्राप्य् एवम् । कथम् ? सर्वं विष्णु-मयं जगत् [वि।पु। ५.१.२०] इत्य् अत्र, प्रसिद्धा या गीः, तस्या अङ्गवत् सा गीर् एव अर्थ । स्वरूपेण प्रत्यक्षा यथा, तथा बभौ इत्य् अर्थः ॥१९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "20": {
      "start": 20,
      "end": 20,
      "sanskrit": "एवं सर्वात्मा सन् व्रजं प्राविशत् । कथं स्वयम् आत्मा इव प्रयोजकः । आत्म-रूपान् गो-वत्सान् इति, कर्मापि स्वयम् एवेत्य् उक्तम् । आत्म-रूपैर् वत्स-पैः प्रतिवार्य । प्रयोज्य कर्तापि स्वयम् एव । आत्म-विहारैः क्रीडन्न् इति क्रियापि कारकाण्य् अपि स्वयम् एवेत्य् अर्थः ॥२०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "21": {
      "start": 21,
      "end": 21,
      "sanskrit": "तत्-तद्-आत्मा तत्-तद्-गोप-बाल-रूपोऽभवत् । ततस् तत्-तत्-सद्म प्रविष्टः ॥२१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "22": {
      "start": 22,
      "end": 22,
      "sanskrit": "गोपिका-मोहम् आह---तन्-मातर इति । तन्-मातरो वेणु-रवेण त्वरयोत्थिताः सत्यः सुतान् मत्वा परं ब्रह्म इव दोर्भिर् उत्थाप्य उदुह्य । पयः-सुधासवं पयः एव सुध-वत् स्वादु आसववन् मादकं पाययाम् आसुर् इत्य् अर्थः ॥२२॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "23": {
      "start": 23,
      "end": 23,
      "sanskrit": "एवं याम-यमेन तत् तत् काल-क्रीडा-नियमेन सायं गतः प्राप्तः स्व-आचरितैः स्वस्याचरितैः, शोभनैर् आचरितैर् वा । मातॄः प्रहर्षयंस् ततस् ताभिर् उन्मर्दनादिभिर् उपलालित इति ॥२३॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "24": {
      "start": 24,
      "end": 24,
      "sanskrit": "गवां मोहनम् आह---गाव इति । परिहूता आहूताश् च ते सङ्गताश् च तान् ॥२४॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "25": {
      "start": 25,
      "end": 25,
      "sanskrit": "एतावत् तु वैषम्यं कृष्णस्यापि दुर्निवारम् आसीद् इत्य् आह---गो-गोपीनाम् इति । गवां गोपीनां च अस्मिन् कृष्णे मातृता उपलालनादि-रूपा पुरोवद् एवासीत् । किन्तु स्नेहर्धिकां विना । स्नेहाधिक्यं त्व् इदानीं विशेष इत्य् अर्थः । आसु गो-गोपीषु हरेस् तोकता च बाल-भावनादि पूर्ववद् एवासीत् । किन्तु मायया विना, ममेयं माता अहम् अस्याः पुत्र इति मोहं विना इत्य् अर्थः ॥२५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "26": {
      "start": 26,
      "end": 26,
      "sanskrit": "स्नेह-र्द्धिम् एव दर्शयति---व्रजौकसाम् इति । यथा कृष्णे यशोदा-नन्दने स्व-पुत्रेभ्योऽपि स्नेहाधिक्यं पूर्वम् आसीत् । इदानीं स्व-तोकेष्व् अपि तथैवावर्धतेत्य् अर्थः । आ अब्दं यावत्-संवत्सरम् । निःसीम यथा भवति ॥२६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "27": {
      "start": 27,
      "end": 27,
      "sanskrit": "एवम् आत्मा श्री-कृष्णो वत्सपो भूत्वा तत्रापि वत्सानां पालानां च मिषेण आत्मानम् आत्मना पालयन् क्रीडितवान् इत्य् अर्थः ॥२७॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "28": {
      "start": 28,
      "end": 28,
      "sanskrit": "एतावत्-पर्यन्तं रामस्यापि मोह एवासीत् । संवत्सरान्ते तु कथञ्चिज् ज्ञातवान् इति दर्शयन्न् आह---एकदा इति । पञ्च-षासु पञ्चसु वा षट्सु वा रात्रिषु हायनस्यापूरणीषु पूरकतयावशिष्टास्व् इत्य् अर्थः ॥२८॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "29": {
      "start": 29,
      "end": 29,
      "sanskrit": "ततो दूरत एव गोवर्धन-शिखरे चरन्त्यो गावो व्रज-समीपे चरतो वत्सान् ददृशुः ॥२९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "30": {
      "start": 30,
      "end": 30,
      "sanskrit": "तदैव स गो-व्रजो गवां कलापस् तत्-स्नेह-वशस् तेषां, वत्सानां स्नेहेनाकृष्टोऽत एव न स्मृत आत्मा येन स जवेन-उपव्रजम् अगात् । कथं-भूतः । अत्यात्म-प-दुर्ग-मार्गः अतिक्रान्त आत्म-पान् गोपालान्यः सोऽत्यात्म-पः, तथा दुर्गमो मार्गो यस्य सः स च स च । तथा परस्पर-युक्ताभ्यां पध्यां धावन् द्वि-पाद् इव प्रतीयमानः । ककुद्य् आकुञ्चिता ग्रीवा यस्य सः । उदास्य-पुच्छः उन्नमितान्यास्यानि पुच्छानि च येन सः । आस्रु-पयाः सर्वतः स्रवन्ति पयांसि यस्य सः । \"आस्नु-पयाः\" इत्य् अपि पाठे स एवार्थः । गो-व्रज इत्य् अनेन वृषभादयोऽप्य् अगुर् इत्य् उक्तम् ॥३०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "31": {
      "start": 31,
      "end": 31,
      "sanskrit": "तत्र विशेषतो धेनूनां चेष्टितम् आह---समेत्य इति । गोवर्धनस्याधः । वत्सवत्यः पुनः प्रसूता अपि ॥३१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "32": {
      "start": 32,
      "end": 32,
      "sanskrit": "रामेण दृष्टं वत्सेषु गवां स्नेहातिशयम् उक्त्वा गोपानाम् अपि दर्शयितुम् आह---गोपा इति । तासां गवां रोधने य आयासस् तस्य मौघ्येन मोघत्वेन लज्जया सहोरु-मन्युना दुर्ग-मार्ग-जनित-क्लेशेन च अभ्येत्य गोवत्सैः सह सुतान् ददृशुः ॥३२॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "33": {
      "start": 33,
      "end": 33,
      "sanskrit": "ततश् च तेषाम् ईक्षणेनोद्गतो यः प्रेम-रसस् तस्मिन्न् आप्लुता निमग्ना आशया येषां ते । लज्जा-मन्यु-कृच्छ्रैस् तान् अपि ताडयितुम् आगताः सन्तोऽपि गत-मन्यवः प्रत्युत जातः अनुरागो येषां ते । मूर्धनि घ्राणैर् अवघ्राणैः परमां मुदम् अवापुः ॥३३॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "34": {
      "start": 34,
      "end": 34,
      "sanskrit": "कृच्छ्रात् ततोऽपगता निवृत्ताः । तेषां सुतानाम् अनुस्मृत्य् उद्गच्छन्त्य् अश्रूणि येषां ते ॥३४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "35": {
      "start": 35,
      "end": 35,
      "sanskrit": "प्रेमर्धेर् औत्कण्ठ्यम् अतिशयं मुक्त-स्तनेष्व् अपत्येषु वीक्ष्य हेतुम् अजानन्न् अचिन्तयत् ॥३५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "36": {
      "start": 36,
      "end": 36,
      "sanskrit": "चिन्ताम् एवाह---किम् एतद् इति द्वाभ्याम् । वासुदेवे यथा पुरा प्रेम, तथा स्व-तोकेष्व् अपि व्रजस्य अपूर्वं प्रेम वर्धते । किम् एतद् अद्भुतम् ? इति । किं च, सात्मनो मत्-सहितस्य व्रजस्य । ममाप्य् एतेषु प्रेमातिशयः, तत्र कारणं किम् ? इति भावः ॥३६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "37": {
      "start": 37,
      "end": 37,
      "sanskrit": "केयं माया देवानां वा नराणां वा असुराणां कुतो वा कस्मात् प्रयुक्ता ? तत्रान्य-माया न सम्भवति । यतो ममापि मोहो वर्तते, अतः प्रायशो मत्-स्वामिनः श्री-कृष्णस्यैव माया इयम् अस्त्व् इति सम्भावयति ॥३७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "38": {
      "start": 38,
      "end": 38,
      "sanskrit": "स-वयसान् सखीन् अपि वयुनेन ज्ञान-मयेन चक्षुषा वैकुण्ठं श्री-कृष्णम् एवापश्यत् ॥३८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "39": {
      "start": 39,
      "end": 39,
      "sanskrit": "एवं कृष्ण-रूपान् सामान्यतो ज्ञात्वा कृष्णं पृष्ट्वा कृष्णोपदेशेन विशेषतो ज्ञातवान् इत्य् आह---न एत इति । अयम् अर्थः---पाल्यमानास् तावद् वत्सा ऋषीणाम् अंशाः, पालाश् च देवानाम् अंशा इति, तावद् अहं वेद्मि । इदानीं तु न तथा, किन्त्व् अस्मिन् भिद्-आश्रयेऽपि त्वम् एव भासि । अतस् त्वं सर्वं पृथक् विविच्य, कथं वृत्तम् ? इति वद इत्य् उक्तेन प्रभुणा वक्त्रा निगमात् सङ्क्षेपत एवोक्तम् । वृत्तं बलः अवैद् विदितवान् इत्य् अर्थः ॥३९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "40": {
      "start": 40,
      "end": 40,
      "sanskrit": "ततः किं वृत्तम् ? इत्य् अपेक्षायाम् आह---तावद् इति । वर्षे जाते आत्मनो मानेन त्रुट्य्-अनेहसा त्रुटि-मात्रेण कालेन । स-कलं सानुचरं हरिं ददर्श ॥४०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "41": {
      "start": 41,
      "end": 41,
      "sanskrit": "दृष्ट्वा च व्यतर्कयद् इत्य् आह---यावन्त इति द्वाभ्याम् । मे मायाशये मन्-मायातल्पे ॥४१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "42": {
      "start": 42,
      "end": 42,
      "sanskrit": "मन्-माया-मोहितेभ्य इतरे कुत्रत्याः ॥४२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "43": {
      "start": 43,
      "end": 43,
      "sanskrit": "इति वितर्कयन्न् अमुह्यद् इत्य् आह---एवम् इति द्वाभ्याम् । एवम् एतेषु भेदेषु चिरं ध्यात्वा स आत्म-भूः इति पाठः ॥४३॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "44": {
      "start": 44,
      "end": 44,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "45": {
      "start": 45,
      "end": 45,
      "sanskrit": "ननु, मायाश्रयस्य तस्य कुतो मोहः ? इत्य् अत आह---तम्याम् इति । महा-मायाविनि भगवत्य् अन्य-मायाया आवरण-विक्षेपकत्वाभावे दृष्टान्त-द्वयम् इतम् । तम्यां तमिस्रायां रात्र्यां नैहारं हिम-कण-प्रभवं तम इव । तद्धितार्थोपसर्जनस्यापि तमसो नैहारम् इति विशेषणं छान्दसम् । तत् तमो यथा पृथग् आवरणं न करोति, किन्तु तत्रैव लीयते । यथा च खद्योतार्चिर् अहनि पृथक् प्रकाशं न करोति । एवं महति पुरुषे मायां युञ्जतः पुंस इतरा नीचा माया तत्र न किञ्चित् करोति, किन्त्व् आत्मनि स्वस्मिन्न् एव ऐश्यं सामर्थ्यं निहन्तीति ॥४५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "46-47": {
      "start": 46,
      "end": 47,
      "sanskrit": "अन्यद् अपि आश्चर्यम् आह---तावद् इति । वत्स-पालाः वत्साः पालाश् च । सर्वे यष्टि-विषाणादयश् च ॥४६-४७॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "48": {
      "start": 48,
      "end": 48,
      "sanskrit": "श्रीवत्स-प्रभा-युक्तान् यद् अङ्गानि दोःषु येषाम्, रत्नमयानि कम्बु-वत् त्रि-धाराणि कङ्कणानि पाणिषु येषां, ते च ते च ॥४८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "49": {
      "start": 49,
      "end": 49,
      "sanskrit": "तथा भूरि बहु-जन्मार्जितं पुण्यं तद् युक्तैर् जनैर् अर्पितैः ॥४९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "50": {
      "start": 50,
      "end": 50,
      "sanskrit": "चन्द्रिका-विशद-स्मित-युक्तैः सह्आरुण-गुणेन च वर्तमाना येऽपाङ्गाः, तैर् वीक्षितैः । स्वकार्थानां स्व-भक्त-मनोरथानां रजः-सत्त्वाभ्यां स्रष्टृ-पालका इव व्यदृश्यन्त । सत्त्ववद् विशद-स्मितेन पालका इव, रजोवद् अरुण-गुणेन च स्रष्टार इव तादृक् कटाक्षैर् द्योतमाना इत्य् अर्थः ॥५०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "51": {
      "start": 51,
      "end": 51,
      "sanskrit": "आत्मा ब्रह्मा तद्-आदि-स्तम्ब-पर्यन्तैः अनेकार्हैर् अनेकार्हणैः ॥५१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "52": {
      "start": 52,
      "end": 52,
      "sanskrit": "अजाद्याभिर् माया-विद्यादिभिर्, विभूतिभिः शक्तिभिः । महद्-आदिभिर् इति महत्-सूत्रयोः पृथक्त्व-विवक्षया चतुर्-विंशति-तत्त्वैर् जगत्-कारणैः ॥५२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "53": {
      "start": 53,
      "end": 53,
      "sanskrit": "कालादिभिश् च तत् सह-कारिभिः । तत्र कालः क्षोभकः । स्वभावः परिणाम-हेतुः । संस्कारो वासनाया उद्बोधकः । स्व-महि-ध्वस्त-महिभिर् भगवन्-महिम्ना तिरस्कृत-स्वातन्त्र्यैर् उक्तैः सर्वैर् अणिमाद्यैः ॥५३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "54": {
      "start": 54,
      "end": 54,
      "sanskrit": "सर्वेषां मूर्तिमत्त्वेऽपि विशेषम् आह---सत्य-ज्ञानेति । सत्याश् च ज्ञान-रूपाश् च अनन्ताश् च आनन्द-रूपाश् च । तत्रापि तद्-एक-मात्रा विजातीय-सम्भेद-रहिताः । तत्रापि च एक-रसाः सदैक-रूपा मूर्तयो येषां ते । यद् वा, सत्य-ज्ञानादि-मात्रैक-रसं यद् ब्रह्म, तद् एव मूर्तिर् येषाम् ते इति । अत एव उपनिषद् आत्म-ज्ञानं सैव दृक् चक्षुर् येषां, तेषाम् अपि । हि निश्चितम् । अस्पृष्ट-भूरि-माहात्म्याः न स्पृष्टं स्पर्श-योग्यं भूरि-माहात्म्यं येषां, ते तथा-भूताः सन्तो व्यदृश्यन्तेति ॥५४॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "55": {
      "start": 55,
      "end": 55,
      "sanskrit": "एवं सकृद् एक-देव ददर्श । पर-ब्रह्मणो विशेषणं यस्येति ॥५५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "56": {
      "start": 56,
      "end": 56,
      "sanskrit": "अतिकुतुकेनाश्चर्येणोद्वृत्य दृष्टीः परावृत्य हंस-पृष्ठे निपत्येति वा । कुतुक-शब्दे तृतीयायाश् छान्दसो लुक् । यद् वा, उद्वृत्य इति छेदः । अतिकुतुकेन उद्वृत्यो विलोड्यो विपर्यस्तः स्वस्मिन्न् इति यावत् । पाठान्तरे त्व् अतिकुतुकेनोद्वृत्तः क्षुभितः । तेषां धाम्ना तेजसा स्तब्ध-सर्वेन्द्रियो ब्रह्मा तूष्णीं निश्चलोऽभूत् । अत्र दृष्टान्तः---पूर् देवी व्रजाधिष्ठात्री काचिद् देवता, तस्या अन्ति समीपे पुत्रिका चतुर्-मुखी-कृतक-प्रतिमेव ॥५६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "57": {
      "start": 57,
      "end": 57,
      "sanskrit": "एवं मोह-मग्नम् अजम् उज्जहारेत्य् आह---इतीति । इरेशे इरा सरस्वती तस्या ईशे ब्रह्मणि किम् इदम् इति मुह्यति सति पश्चात् तद् द्रष्टुम् अप्य् अनीशे सति परमोऽजः श्री-कृष्णः सपद्य् अजा-जवनिकां माया-रूपां तिरस्करिणीं यया अद्भुतं दर्शितं तां चच्छाद तिरो-धत्त, अपसारितवान् इत्य् अर्थः ।\n\nअथवा, अयं लोकाभिमानी ममैश्वर्यं द्रष्टुम् अयोग्य इति तस्योपरि मायां प्रसारितवान् इति । कस्मिन् स्वरूपे मुमोह तद् आह---अतर्क्ये तर्कागोचरे । निजोऽसाधारणो महिमा यस्य, तस्मिन्न् इति मोहे हेतुद्वयम् उक्तम् । दर्शनायोग्यत्वाय त्रीणि विशेषणानि । स्व-प्रमितिके स्व-प्रकाशं च तत् कं सुखं च यस्मिन् । अत एव अजातः प्रकृतेः परत्र परस्मिन् । अतन्-निरसन-मुखेन ब्रह्मकैः श्रुति-शिरोभिर् मितिर् ज्ञानं यस्मिन्, तस्मिन् स्वरूपे ॥५७॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "58": {
      "start": 58,
      "end": 58,
      "sanskrit": "अर्वक् बहिः प्रतिलब्धान्य् अक्षीणि येन सः । परेतवन् मृतो यदि कथञ्चित् पुनर् उत्तिष्ठति तथा । दृष्टीर् नेत्राणि ॥५८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "59": {
      "start": 59,
      "end": 59,
      "sanskrit": "जनानाम् आजीव्यैर् द्रुमैर् आकीर्णम् । समा-प्रियं सन्ततान्य् आसमन्तात् प्रियाणि यस्मिंस् तत् ॥५९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "60": {
      "start": 60,
      "end": 60,
      "sanskrit": "तद् आह---यत्रेति । नैसर्ग-दुर्वैराः स्वाभाविकाप्रतिकार्य-वैरवन्तोऽपि नराः सिंहादयश् च मित्राणीव यत्र सहैवासन् । अजितस्यावासेन द्रुताः पलायिताः रुट्-तर्षादयः क्रोध-लोभादयो यस्मात् तत्राभूतं वृन्दावनम् अपश्यद् इति ।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "61": {
      "start": 61,
      "end": 61,
      "sanskrit": "तत्र च परमेष्ठी ब्रह्मा इव पुरा पूर्ववद् एव ब्रह्म अचष्टापश्यत् । कथं-भूतम् ? पशुप-वंश-शिशुत्वं नाट्यम् उद्वहत् । नाट्यम् इत्य् अत्र हेतुः, अद्वयम् इत्य्-आदि । अद्वयं च वत्सान् विचिन्वत्, एकं च सखीन्, अगाध-बोधं च विचिन्वत् । अनन्तं च परितो विचिन्वत्, परं च शिशुत्वम् उद्वहत्, ब्रह्म च स-पाणि-कवलम् इति नाट्यम् एवोद्वहद् इत्य् अर्थः ॥६१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "62": {
      "start": 62,
      "end": 62,
      "sanskrit": "निज-धोरणतः स्व-वाहनात् त्वरेण वेगेनावतीर्य दण्डवन् नत्वा चतुर्णां मुकुटानाम् अग्रैर् अङ्घ्रि-युग्मं स्पृष्ट्वा मुद्-अश्रु-सुजलैर् आनन्दाश्रु-रूपैः सुजलैर् अभिषेकम् अकरोद् इति ॥६२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "63": {
      "start": 63,
      "end": 63,
      "sanskrit": "चिरस्य चिरं पादयोः पतन्न् आस्ते ॥६३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "64": {
      "start": 64,
      "end": 64,
      "sanskrit": "स-वेपथुः स-कम्पः । अत एव गद्गदया । अनुकरणम् एतत् । इलया वाचा । ऐलत अस्तौत् ॥६४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    }
  }
}
