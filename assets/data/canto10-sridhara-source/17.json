{
  "chapter": 17,
  "source_path": "12-17/17.md",
  "entries": {
    "1": {
      "start": 1,
      "end": 1,
      "sanskrit": "नागं सप्तदशे नागा लयं तं निरयापयत् ।\n\nबन्धून् स्व-दुःखतः श्रान्तान् सुप्तांस् तत्र दवाद् अपात् ॥\n\nअसमञ्जसम् अप्रियम् ॥१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "2": {
      "start": 2,
      "end": 2,
      "sanskrit": "उपहार्यैर् भक्ष्यैः । सर्प-जनैः सर्पायतैर् जनैः । वानस्पत्यो वनस्-पतेर् मूले देयो नागानां तद्-बाधा-परिहाराय यो बलिर् निरूपित उपकल्पितः ॥२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "3": {
      "start": 3,
      "end": 3,
      "sanskrit": "ते च नागाः स्वं स्वं भागं जनैर् दत्तं सुपर्णाय प्रयच्छन्ति ततो भीताः । गोपीथाय रक्षणाय ॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "4": {
      "start": 4,
      "end": 4,
      "sanskrit": "विष-वीर्याभ्यां यो मदस् तेनाविष्टः । काद्रवेयः कद्रू-पुत्रः । गरुड कदर्थी-कृत्य अविगणय्य । यद् वा, उपहार्यैः सुपर्ण-भक्ष्यैः सर्पा एव जनास् तैर् नागानां सम्बन्धी यस्मिन्न् एकैको नागो दीयते तथा-भूतो यो बलिः सुपर्णाय निरूपितस् तत्र स्वं स्वं भागं सर्वे नागाः प्रयच्छन्ति, कालियस् तु न प्रयच्छति, किन्त्व् अन्यैर् दत्तम् अपि तं बलिं स्वयम् एव बुभुजे ॥४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "5": {
      "start": 5,
      "end": 5,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "6": {
      "start": 6,
      "end": 6,
      "sanskrit": "विषम् एव्आयुधं यस्य सः । प्रत्यभ्ययाद् योद्धुं प्रतिजगाम् । उच्छ्रित-नैक-मस्तक उन्नमितानेक-फणः । दद्-आयुधो दन्तायुधः । कराल-जिह्वश् चासाव् उच्छ्वसितोग्र-लोचनश् च उच्छ्वसितान्य् उज्जृम्भितान्य् उग्राणि लोचनानि यस्य सः ॥६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "7": {
      "start": 7,
      "end": 7,
      "sanskrit": "तार्क्ष्य-पुत्रो गरुडः । मधुसूदनस्यासनं यस्मिन् सः ॥७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "8": {
      "start": 8,
      "end": 8,
      "sanskrit": "तस्य गरुडस्य्आगम्यम् अगाधतया च दुरासदम् ॥८॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "12": {
      "start": 12,
      "end": 12,
      "sanskrit": "लेलिहः सर्पः । अतस् तत्र्आवात्सीत् ॥१२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "13": {
      "start": 13,
      "end": 13,
      "sanskrit": "जाम्बू-नदं सुवर्णं तेनालङ्कृतम् ॥१३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "15": {
      "start": 15,
      "end": 15,
      "sanskrit": "लब्धेहा लब्ध-चेष्टाः ॥१५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "16": {
      "start": 16,
      "end": 16,
      "sanskrit": "नगा वृक्षा अपि पूर्वं शुष्काः सन्तः एव विरूढा इत्य् अर्थः ॥१६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "17": {
      "start": 17,
      "end": 17,
      "sanskrit": "ते विप्रा ऊचुः ॥१७.१८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "18": {
      "start": 18,
      "end": 18,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "19": {
      "start": 19,
      "end": 19,
      "sanskrit": "नष्ट-लब्ध-प्रजा नष्ट-प्राया पुनर्-लब्धा प्रजा यया सा ॥१९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "20": {
      "start": 20,
      "end": 20,
      "sanskrit": "श्रमेण च कर्षिताः उपकूलतः कूल-प्रान्ते ॥२०.२३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "21": {
      "start": 21,
      "end": 21,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "23": {
      "start": 23,
      "end": 23,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    }
  }
