{
  "chapter": 15,
  "source_path": "12-17/15.md",
  "entries": {
    "1": {
      "start": 1,
      "end": 1,
      "sanskrit": "ततः पञ्चदशे धेनु-पालनं धेनुकार्दनम् ।\n\nकालिय-क्ष्वेडतो गोप-रक्षणं च निरूप्यते ॥*॥\n\nअहि-वक्त्र-प्रवेशेन वृथा खिन्नान् सखीन् अतः ।\n\nकृष्णः प्रावेशयत् पक्व-फलं तालालि-काननम् ॥॥\n\nपशु-पाल-सम्मतौ पशु-पालने सम्मतौ, पशु-पालानां वा सम्मतौ । ईषद्-वयो-बलातिरेकम् अनुकृतवन्ताव् इत्य् अर्थः । अतीव चक्रतुः सर्वतः प्रसर्पणेन ॥१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "2": {
      "start": 2,
      "end": 2,
      "sanskrit": "स्व-यशो गृणद्भिर् गोपैर् वृतस् तद् वनं प्राविशत् ॥२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "3": {
      "start": 3,
      "end": 3,
      "sanskrit": "तद् वनं निरीक्ष्य रन्तुं मनो दधे । कथं-भूतम् ? मञ्जु-घोषा येऽलि-मृग-द्विजा भ्रमर-मृग-पक्षिणः, तैर् आकुलं व्याप्तं महन्-मनः-प्रख्य-पयः-सरस्वता महतां मनसा प्रख्यं तुल्यं स्वच्छं पयो यस्मिंस् तत् सर आश्रयत्वेनास्ति यस्य, तेन वातेन इति शैत्यम् उक्तम् । शत-पत्र-गन्धिना इति परिमलवत्त्वम् । जुष्टं वनम् इति मान्द्यं सूचितम् ॥३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "4": {
      "start": 4,
      "end": 4,
      "sanskrit": "अरुण-पल्लव-श्रिया सह । स्पृशन्त्यः शिखाः शाखाग्राणि येषां तान् ॥४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "5": {
      "start": 5,
      "end": 5,
      "sanskrit": "तरु-जन्म येन तमसा कृतं, तस्य तमसः पापस्य अपहत्यै नाशाय । अथवा येन त्वया ईश्वरेण सर्वोपकारकं तरु-जन्म कृतं तं त्वां नमन्ति । एवं श्लाघ्येऽपि जन्मनि यद् अज्ञान-रूपं तमोऽस्ति तस्य अपहत्यै ॥५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "6": {
      "start": 6,
      "end": 6,
      "sanskrit": "हे अनघ ! वने गूढम् अपि त्वां न त्यजन्ति । त्वयि मनुष्य-वेषेण निगूढे सति मुनयोऽप्य् अलि-वेषेण निगूढास् त्वां भजन्तीत्य् अर्थः ॥६॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "7": {
      "start": 7,
      "end": 7,
      "sanskrit": "इयान् हि सतां निसर्ग इति । यद् अस्ति स्वस्मिंस् तद् गृहम् आगताय महते महा-पुरुषाय समर्पयन्तीति ॥७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "8": {
      "start": 8,
      "end": 8,
      "sanskrit": "तृण-वीरुधश् च तव पादौ स्पृशन्तीति तथा । करजाभिमृष्टा नखैः स्पृष्टाः । सदयैर् अवलोकनैः । श्रीर् अपि यस्मै स्पृहयति केवलं, तेन भुजयोर् अन्तरेण वक्षसा गोप्यो धन्या इति ॥८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "9": {
      "start": 9,
      "end": 9,
      "sanskrit": "एवं श्रीमद् वृन्दावनं प्रति प्रीतः सन्न् अद्रेः समीप-वर्ति-सरित्-तटेषु पशून् सञ्चारयन् सानुगो गोपैः सह वर्तमानः प्रीत-मना रेमे ॥९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "10": {
      "start": 10,
      "end": 10,
      "sanskrit": "ताम् एव रतिम् आह---क्वचिद् इत्य्-आदि-दशभिः ॥१०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "12": {
      "start": 12,
      "end": 12,
      "sanskrit": "बर्हिणं नृत्यन्तम् अनु अभिनृत्यति । बर्हिणम् अभिमुखो नृत्यतीति वा । सखीन् हासयन् ॥१२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "13": {
      "start": 13,
      "end": 13,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "14": {
      "start": 14,
      "end": 14,
      "sanskrit": "चकोरादीन् अनुकृत्य रौति । कदाचिच् च सत्त्वानां मध्ये व्याघ्र-सिंहयोस् ताभ्यां भीतवद् भवति । सत्त्वेषु पलायमानेषु पलायत इत्य् अर्थः । तयोः सत्त्वानां बलोद्रेकाणां भीतवद् भवतीति वा ॥१४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "15": {
      "start": 15,
      "end": 15,
      "sanskrit": "आर्यम् अग्रजम् । विश्रमयति विगत-श्रमं करोति ॥१५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "16": {
      "start": 16,
      "end": 16,
      "sanskrit": "मिथो नृत्यादीन् कुर्वतो गोपान् प्रशशंसतुः ॥१६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "17": {
      "start": 17,
      "end": 17,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "18": {
      "start": 18,
      "end": 18,
      "sanskrit": "व्यजनैः पल्लवादि-निर्मितैः ॥१८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "19": {
      "start": 19,
      "end": 19,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "20": {
      "start": 20,
      "end": 20,
      "sanskrit": "ईश-चेष्टित इति । निगूढ-स्वभावत्वेऽप्य् अन्तरान्तरा ईशस्यैव चेष्टितानि दृश्यन्तेऽस्मिन् सः ॥२०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "21": {
      "start": 21,
      "end": 21,
      "sanskrit": "ईश-चेष्टितत्वम् एव दर्शयितुम् आह---श्रीदामा इति । स्तोक-कृष्णः क्वचित् ॥२१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "22": {
      "start": 22,
      "end": 22,
      "sanskrit": "तालालि-सङ्कुलं ताल-पङ्क्तिभिर् व्याप्तम् ॥२२-२४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "23": {
      "start": 23,
      "end": 23,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "24": {
      "start": 24,
      "end": 24,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "25": {
      "start": 25,
      "end": 25,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "26": {
      "start": 26,
      "end": 26,
      "sanskrit": "विषूचीनः सर्वतः प्रसृतः ॥२६-२८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "27": {
      "start": 27,
      "end": 27,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "28": {
      "start": 28,
      "end": 28,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "29": {
      "start": 29,
      "end": 29,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "30": {
      "start": 30,
      "end": 30,
      "sanskrit": "स-नगं स-वृक्षम् ॥३०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "31": {
      "start": 31,
      "end": 31,
      "sanskrit": "तरसा समेत्य प्रत्यग् द्वाभ्यां पद्भ्यां बलं उरसि निहत्य बली खलः का-शब्दं मुञ्चन् ॥३१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "32": {
      "start": 32,
      "end": 32,
      "sanskrit": "उपक्रोष्टा गर्दभः । पराक् प्रतिमुखः । अपरौ पश्चिमौ । बलाय बलं हन्तुम् ॥३२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "33": {
      "start": 33,
      "end": 33,
      "sanskrit": "तृण-राजस् तालः ॥३३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "34": {
      "start": 34,
      "end": 34,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "35": {
      "start": 35,
      "end": 35,
      "sanskrit": "उत्सृष्टेन खर-देहेन हतैर् आहताः । चकम्पिरे अकम्पन्त ॥३५-३७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "36": {
      "start": 36,
      "end": 36,
      "sanskrit": "यस्मिन्न् इदं विश्वम् ओतम् ऊर्ध्व-तन्तुषु पट इव ग्रथितम्, प्रोतं तिर्यक् तन्तुषु पटवद् एव सङ्ग्रथितम् । सर्वतोऽस्यूतं वर्तत इत्य् अर्थः ॥३६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "37": {
      "start": 37,
      "end": 37,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "38": {
      "start": 38,
      "end": 38,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "39": {
      "start": 39,
      "end": 39,
      "sanskrit": "घनैर् नभ इव भुवस् तलं रराज । तत्र फल-प्रकर-सङ्कीर्णम् इति दैत्य-देहैश् च स-तालाग्रैः सङ्कीर्णम् इत्य् अरुणश् चेत-नील-घन-सादृश्य-संपादनम् ॥३९.४०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "40": {
      "start": 40,
      "end": 40,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "41": {
      "start": 41,
      "end": 41,
      "sanskrit": "आदन्न् अभक्षयन् ॥४१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "42": {
      "start": 42,
      "end": 42,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "43": {
      "start": 43,
      "end": 43,
      "sanskrit": "गो-रजोभिश् छुरितेषु कुन्तलेषु बद्धं बर्हं वन्यानि प्रसूनानि च यस्य । रुचिरम् ईक्षणं चारु-हासश् च यस्य, तं च तं च । दिदृक्षित-दृशो दिदृक्षिता दर्शनोत्कण्ठा-युक्ता दृशो यासां ताः ॥४३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "44": {
      "start": 44,
      "end": 44,
      "sanskrit": "मुकुन्दस्य मुख-पद्म-गतं सारघं मधु । अह्नि यो विरहः, तस्माज् जातं तापम् । स च तासां सत्कृतिं पूजाम् । कां सत्-कृतिं ? कथं वा कृतां ? ताम् आह---स-व्रीडेन स-लज्जेन हासेन विनयो यथा भवति तथा यद् एतत् । किं तत् ? अपाङ्ग-मोक्षं कटाक्ष-दर्शनम् । तथा तां सत्-कृतिं प्राप्येति ॥४४.५१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "45": {
      "start": 45,
      "end": 45,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
