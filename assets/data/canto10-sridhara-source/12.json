{
  "chapter": 12,
  "source_path": "12-17/12.md",
  "entries": {
    "1": {
      "start": 1,
      "end": 1,
      "sanskrit": "द्वादशे तु महा-सर्प-वपुर्-धरम् अघासुरम् ।\n\nवत्स-पाल-गिलं क्रुद्धो गलेऽहन्न् इति वर्ण्यते ॥*॥\n\nमहा-बक-गल-क्रीडा केवलस्य न कौतुकम् ।\\ इतीवाघासुर-मुखे स-सखः प्राविशद् धरिः ॥॥\n\nक्वचित् कदाचिद् वनाशाय वन एव प्रथमं भोजनं कर्तुम् ॥१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "2": {
      "start": 2,
      "end": 2,
      "sanskrit": "तेनैव शृङ्ग-रवेण श्री-कृष्णेन वा सह । पृथुका बालाः स्निग्धाः स्नेह-युक्ताः । शिक् शिक्यम् । रम्या शिग्-वेत्रादयो येषां ते । सहस्राधिक-सङ्ख्या-युक्तान् वत्सान् ॥२.३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "3": {
      "start": 3,
      "end": 3,
      "sanskrit": "पूर्व श्लोकस्य व्याख्या द्रष्टव्य ।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "4": {
      "start": 4,
      "end": 4,
      "sanskrit": "काच-आदिभिः पूर्वं मातृभिर् भूषिता अपि फल-आदिभिर् आत्मानम्-अभूषयन्न् इत्य् अर्थः ॥४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "5": {
      "start": 5,
      "end": 5,
      "sanskrit": "मुष्णन्तश् चोरयन्तः ॥५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "6": {
      "start": 6,
      "end": 6,
      "sanskrit": "यदि दूरं गतः कृष्णो भवति, तर्हि ॥६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "7": {
      "start": 7,
      "end": 7,
      "sanskrit": "ध्मान्तो वादयन्तः । भृङ्गैः सह ॥७॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "8": {
      "start": 8,
      "end": 8,
      "sanskrit": "विच्छायाभिः पक्षि-च्छायाभिः । कलापिभिर् मयूरैः ॥८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "9": {
      "start": 9,
      "end": 9,
      "sanskrit": "कीश-बालान् वृक्ष-शाखासु लम्बमानानि वानर-लाङ्गूलान्य् आकर्षन्तो लाङ्गूलम् अमुञ्चन्तस् तैः सह द्रुमान् आरोहन्तः । विकुर्वन्तो दन्त-दर्शन-भ्रू-विजृम्भादिभिस् तैः सह विकारान् कुर्वन्तः । पलाशिषु वृक्षेषु प्लवन्तः शाखायाः शाखान्तरम् उद्गच्छन्तः ॥९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "10": {
      "start": 10,
      "end": 10,
      "sanskrit": "प्रतिच्छायाः प्रतिबिम्बानि ॥१०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "11": {
      "start": 11,
      "end": 11,
      "sanskrit": "तान् अतिविस्मितः श्लोक-द्वयेनाभिनन्दति---इत्थम् इति । सतां विदुषां ब्रह्म च तत्-सुखं चानुभूतिश् च तथा स्व-प्रकाश-परम-सुखेनेत्य् अर्थः । भक्तानां पर-दैवतेन आत्म-प्रदेन नाथेन, मायाश्रितानां तु नर-दारकतया प्रतीयमानेन सह विजह्रुः । कृतानां पुण्यानां पुञ्जा राशयो येषां ते । ब्रह्म-विदां तद्-अनुभव एव भक्तानाम् अतिगौरवेणैव भजनम् । एते तु तेन सह सख्येन विजह्रुः । अहो भाग्यम् इति भावः ॥११॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "12": {
      "start": 12,
      "end": 12,
      "sanskrit": "बहु-जन्मभिः कृच्छ्रेण धृत आत्मा मनो यैस् तैर् अपि ॥१२॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "13": {
      "start": 13,
      "end": 13,
      "sanskrit": "सुख-क्रीडन-वीक्षणेन क्षमा यस्य सः । कथम्-भूतः । यस्यान्तर् अन्तरं छिद्रं पीतामृतैर् अपि ततो मृत्यु-भीतैर् अमरैः प्रतीक्ष्यते कथं मरिष्यति कदा वेति । यद् वा, कथं-भूतं सुख-क्रीडनम् । यद्-अन्तर्-हृदये अमरैः प्रतीक्ष्यते विचिन्त्यते पीतामृतैर् अपि पुनर् निज-जीवितेप्सुभिः । अयं भावः, नामृत-पान-मात्रेण जीवनं स-फलं भवति किन्तु भगवल्-लीलानुस्मरणेनेति तद् एव नित्यम् अन्तश् चिन्त्यत इति ॥१३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "14": {
      "start": 14,
      "end": 14,
      "sanskrit": "कृष्ण-प्रमुखान् अर्भकान् दृष्ट्वा स इति व्यवसु निश्चित्याजगरं वपुर् धृत्वा तेषां ग्रस-नाशया पथि व्यशेतेति तृतीयेनान्वयः । कंसेनानुशिष्टः प्रहितः । बकी पूतना । कथं व्यवस्य तद् आह---अयं त्व् इति सार्धेन । मम तयोर् द्वयोः सोदरयोः स्थाने एनं कृष्णं स-बलं स-सैन्यं वत्स-तत्-पाल-सहितं हनिष्यामि ॥१४॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "15": {
      "start": 15,
      "end": 15,
      "sanskrit": "ननु, तथापि व्रज-स्थास् त्व् अवशिष्येरन्न् एत्य् आह---एत इति । तिलापः कृतास् तिलोदकतया कल्पिताः । वर्ष्मसु देहेषु । प्रजा एवासवो येषां ते तथा ॥१५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "16": {
      "start": 16,
      "end": 16,
      "sanskrit": "स योजनायामं योजन-प्रमाणेन दैर्घ्येण युक्तं च तन् महाद्रिवत्-पीवरं च । व्यात्तं प्रसारितं गुहा-तुल्यम् आननं यस्मिंस् तत् ॥१६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "17": {
      "start": 17,
      "end": 17,
      "sanskrit": "अद्भुतम् इति यद् उक्तं, तद् दर्शयितुं विशिनष्टि । धरायाम् अधरोष्ठो यस्य सः। जलदेषु उत्तरोष्ठो यस्य सः । दर्याव् इवाननस्यान्तौ सृक्किणी यस्य सः । गिरेः शृङ्गाणीव दंष्ट्रा यस्य सः । ध्वान्तवद् अन्तरास्यं यस्य सः । वितताध्व-वज् जिह्वा यस्य सः । परुषानिल-वच्-छ्वासो यस्य सः । दव-वद्-ईक्षणयोर् उष्णः, दाववद् दृष्टिर् इत्य् अर्थः । परुषानिल-श्वासश् चासौ दवेक्षणोष्णश् च तथा ॥१७॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "18": {
      "start": 18,
      "end": 18,
      "sanskrit": "वस्तुतोऽजगरम् एव व्यात्त-तुण्डं दृष्ट्वा वृन्दावनस्य श्रीः संपदेषेति भ्रान्त्या मत्वा विपरीतं व्यात्ताजगर-तुण्ड-सादृश्येनोत्प्रेक्षितवन्तः ॥१८॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "19": {
      "start": 19,
      "end": 19,
      "sanskrit": "उत्प्रेक्षाम् एव प्रश्नोत्तराभ्याम् आहुः---अहो इति । सत्त्व-कूटं सत्त्वाभासम् इदं वा न वा । तत्राप्य् अस्मत् सङ्ग्रसनाय व्यात्तं यद् व्याल-तुण्डं तद्वद्-आचरति वा न वा ॥१९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "20": {
      "start": 20,
      "end": 20,
      "sanskrit": "निश्चितं तथैवेत्य् आहुः---सत्यम् इति । अर्क-करैर् आरक्तं घनम् उत्तरोष्ठ-वत् पश्यत । तस्य घनस्य प्रतिच्छाययारुणं रोधः स्थलम् अधरोष्ठ-वत् पश्यत । पश्यतेति सर्वत्रान्वेति ॥२०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "21": {
      "start": 21,
      "end": 21,
      "sanskrit": "सृक्किभ्याम् ओष्ठ-प्रान्ताभ्यां प्रतिस्पर्धेते तुल्यतया वर्तेते । नगोदरे गिरि-दर्यौ । एतास् तुङ्ग-शृङ्गालयस् तस्य दंष्ठ्राभिः स्पर्धमानाः ॥२१॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "22": {
      "start": 22,
      "end": 22,
      "sanskrit": "आस्तृतायाम-मार्गो विस्तृतो दैर्घ्यवान् मार्गः । प्रतिगर्जति प्रतिस्पर्धते । एषां शृङ्गाणाम् अन्तर् गतं मध्य-गतं ध्वान्तम् एतद् अन्तर् आननम् आननस्य मध्यं प्रति गर्जति ॥२२॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "23": {
      "start": 23,
      "end": 23,
      "sanskrit": "दावेनोष्णः खरो वातोऽयम्, तेन दावाग्निना दग्धानां सत्त्वानां यो दुर्गन्धः, स एव सर्प्आन्तर्-गत्आमिष-गन्धवद् भाति ॥२३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "24": {
      "start": 24,
      "end": 24,
      "sanskrit": "एवं सन्तम् एवाजगरम् अन्यथोत्प्रेक्ष्य निर्भया ययुः । किं ग्रसिता ग्रसिष्यति ? अनेन श्री-कृष्णेन हन्त्रा । बकारेर् उशत् कमनीयं मुखम् ॥२४॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "25": {
      "start": 25,
      "end": 25,
      "sanskrit": "अमृषा वस्तुतः सर्प-वपुर् असुर एव मृषायते स्वानां सर्प-सादृश्य-गोचरत्वेन प्रतीयते इति तान् निरोद्धुं वारयितुं यावन् मनो दधे तावत् प्रविष्टा इत्य् उत्तरेणान्वयः ॥२५॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "26": {
      "start": 26,
      "end": 26,
      "sanskrit": "तावत् प्रविष्टा एव केवलं, न तु तेन गीर्णा गिलिताः । जीर्णाः इति पाठेऽपि स एवार्थः । कथं भूतेन । हतयोः स्वकयोर् अन्तं स्मरत्य् अनुध्यायतीति तथा तेन । अत एव बकारेः श्री-कृष्णस्य प्रवेशं प्रतीक्षमाणेन ॥२६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "27": {
      "start": 27,
      "end": 27,
      "sanskrit": "स्व-कराद् अवच्युतान् विनिःसृतान् । विस्मितः सन् कृत्यं किम् अत्र इत्य्-आदि विचिन्त्य तत्रोपायं ज्ञात्वा स्वयम् अप्य् अविशद् इत्य् अन्वयः ॥२७-२८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "28": {
      "start": 28,
      "end": 28,
      "sanskrit": "कथं विचिन्त्य । अस्य जीवनम् अमीषा च विहिंसनम् इति द्वयं वै निश्चितं कथं न स्याद् इति ॥२८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "29": {
      "start": 29,
      "end": 29,
      "sanskrit": "घन-च्छदा मेघान्तरिताः । कौणपाः कूणपाशिनो राक्षसाः, कोणपो निरृतिस् तदीया इति वा ॥२९॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "30": {
      "start": 30,
      "end": 30,
      "sanskrit": "चूर्णी-कर्तुम् इच्छोस् तस्य गले आदाव् एव तरसा ववृधे अवर्धत ॥३०॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "31": {
      "start": 31,
      "end": 31,
      "sanskrit": "निरुद्धो मुखादीनां मार्ग-भूतः कण्ठो यस्यास्ति तस्योद्गीर्ण-दृष्टेर् बहिर् निर्गत-लोचनस्यान्तरङ्गे देह-मध्ये पूर्णः परिभृतो मूर्धन् मूर्धनि ब्रह्म-रन्ध्रं निर्भिद्य बहिर् विनिर्गतः ॥३१॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "32": {
      "start": 32,
      "end": 32,
      "sanskrit": "प्राणेष्व् इन्द्रियेषु । स्वयामृत-वर्षिण्या दृष्ट्यैव ॥३२॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "33": {
      "start": 33,
      "end": 33,
      "sanskrit": "अहि-देहे स्थितं शुद्ध-सत्त्वमयं ज्योतिर् निर्गत्य खेऽवस्थितम् । तस्मिन्न् ईशे विवेश ॥३३॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "34": {
      "start": 34,
      "end": 34,
      "sanskrit": "स्व-कृतः स्व-कार्य-कृतः श्री-कृष्णस्यार्हणम् अकृताकुर्वत पूजाम् अकुर्वन् । सुगाः सुष्ठु गायन्तीति गन्धर्वादयः ॥३४॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "35": {
      "start": 35,
      "end": 35,
      "sanskrit": "किं च, तेषां यान्य् अद्भुत-स्तोत्रादीनि तेषां नैकोत्सवा ये मङ्गल-स्वनास् तान् स्व-धाम्नोऽन्ति समीपे श्रुत्वाजो ब्रह्माचिराद् आगत ईशस्य श्री-कृष्णस्य महि महिमानं दृष्ट्वा विस्मयं प्रापेति ॥३५॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "36": {
      "start": 36,
      "end": 36,
      "sanskrit": "बहु-तिथं बहु-कालम् । आक्रीड-गह्वरं क्रीडार्थं महा-बिलम् ॥३६॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "37": {
      "start": 37,
      "end": 37,
      "sanskrit": "अन्यच् चाति-चित्रं वृत्तम् इत्य् आह---एतद् इति ।\n\n> कौमारं पञ्चमाब्दान्तं पौगण्डं दशमावधि । >\n> कैशोरम् आ-पञ्च-दशाद् यौवनं तु ततः परम् ॥\n\nहरेः कौमारजं पञ्चमाब्द-कृतं कर्म तदैव दृष्ट्वा पौगण्डके षष्ठेऽब्दे बाला अद्यैवैतद्-वृत्तम् इत्य् ऊचुः । किं तत् कर्म । मृत्योः सकाशाद् आत्मनाम् अहेश् च मोक्षणम् । आत्मनां प्रसिद्धान् मृत्योर् अहेस् तु संसार-लक्षणात् । अघासुरस्य ज्योतिषः श्री-कृष्णे प्रवेशम् अपि तदा दृष्टं कथितवन्त इत्य् अर्थः ॥३७॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "38": {
      "start": 38,
      "end": 38,
      "sanskrit": "नैतद् विचित्रम् इति । किं तद् इत्य् अपेक्षायाम् आह---अघोऽपीति । आत्म-साम्यं स्व-समान-रूपताम् ॥३८॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "39": {
      "start": 39,
      "end": 39,
      "sanskrit": "यस्य-अङ्गं मूर्तिस् तस्य प्रतिमा प्रतिकृतिस् तत्रापि केवलं मनो-मयी साऽपि बलाद् अन्तर्-आहिता सती भागवतीं गतिं ददौ प्रह्रादादिभ्यः, स एव साक्षात् स्वयम् अन्तर्-गतः किं पुनः नित्या चासाव् आत्म-सुखानुभूतिश् च तयाभितो व्युदस् ता माया येन सः ॥३९॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "40": {
      "start": 40,
      "end": 40,
      "sanskrit": "येन श्रवणेन निगृहीतं वशी-कृतं चेतो यस्य सः ॥४०॥\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "41": {
      "start": 41,
      "end": 41,
      "sanskrit": "कालान्तरे कौमारे कृतं पौगण्डके कथं ज्ञात्वोचुर् इत्य् अर्थः ॥४१.४३॥\n\n---------------------------------------------------------------------------------------------------------------------**",
      "source_available": true
    },
    "42": {
      "start": 42,
      "end": 42,
      "sanskrit": "न व्याख्यातम्।\n\n---------------------------------------------------------------------------------------------------------------------",
      "source_available": true
    },
    "43": {
